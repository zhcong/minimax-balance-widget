<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="MiniMax Balance"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiniMaxBalanceWidget">

        <activity
            android:name=".config.ConfigActivity"
            android:exported="true"
            android:label="Configure Widget">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
            </intent-filter>
        </activity>

        <receiver
            android:name=".ui.widget.MiniMaxBalanceWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/minimax_balance_widget_info"/>
        </receiver>

    </application>

</manifest>